{
  "name": "Mobile PWA UX Shell",
  "short_name": "PWA UX",
  "description": "Каркас мобильного UX с состояниями загрузки/ошибок и офлайн-режимом.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8fafc",
